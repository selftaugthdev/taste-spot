# Copy to .env.local (or set as Cloudflare Pages/Workers build env vars).
# Each site is a SEPARATE deployment with its own Supabase project, Stripe
# account/products, and analytics site — these variable NAMES are shared
# across sites, but every site gets its own VALUES.

# --- Site selection -----------------------------------------------------
# Selects which sites/<id>/config.ts is built in. Required.
SITE_ID=food

# --- Supabase (this site's own project; Free plan to start) -------------
# Public — safe to expose to the browser (RLS protects your data, not these).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — used by scheduled backup/admin scripts, never shipped to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe (this site's own account/products) ---------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs referenced by env var name from sites/<id>/config.ts (see `pro` config).
STRIPE_PRICE_ID_FOOD_MONTHLY=price_...
STRIPE_PRICE_ID_FOOD_YEARLY=price_...

# --- Error tracking (Sentry free tier) ------------------------------------
NEXT_PUBLIC_SENTRY_DSN=

# --- Analytics (privacy-friendly, cookieless — e.g. Plausible or Umami) --
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=

# --- Backups (scheduled GitHub Action; see COSTS.md) ----------------------
# R2 (or S3-compatible) bucket credentials for storing nightly pg_dump output.
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_R2_BUCKET=
